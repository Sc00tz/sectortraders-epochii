# Copy to .env and set a real password before the first start.
POSTGRES_PASSWORD=change-me
POSTGRES_USER=sectortraders
POSTGRES_DB=sectortraders

# Host port the game is published on.
ST_PORT=3000

# Daily reset (turns, port restock) runs on this cron schedule in this timezone.
TZ=America/New_York
RESET_CRON=0 0 * * *

# Set to true once the game is served over HTTPS (behind your reverse proxy).
SECURE_COOKIES=false
